{
  "name": "@concile/cli",
  "version": "0.1.5",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "bin": {
    "concile": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http-handler": {
      "types": "./dist/http-handler.d.ts",
      "default": "./dist/http-handler.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./bin": {
      "default": "./dist/bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude 'test/*-e2e.test.ts' --testTimeout=60000 --hookTimeout=60000",
    "test:e2e": "vitest run test/*-e2e.test.ts --testTimeout=60000 --hookTimeout=60000",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@concile/admin": "workspace:*",
    "@concile/blobstore": "workspace:*",
    "@concile/blobstore-fs": "workspace:*",
    "@concile/blobstore-s3": "workspace:*",
    "@concile/codegen": "workspace:*",
    "@concile/component": "workspace:*",
    "@concile/deploy": "workspace:*",
    "@concile/docstore": "workspace:*",
    "@concile/docstore-postgres": "workspace:*",
    "@concile/docstore-sqlite": "workspace:*",
    "@concile/errors": "workspace:*",
    "@concile/executor": "workspace:*",
    "@concile/id-codec": "workspace:*",
    "@concile/objectstore": "workspace:*",
    "@concile/objectstore-fs": "workspace:*",
    "@concile/objectstore-s3": "workspace:*",
    "@concile/query-engine": "workspace:*",
    "@concile/receipts": "workspace:*",
    "@concile/runtime-embedded": "workspace:*",
    "@concile/storage": "workspace:*",
    "@concile/sync": "workspace:*",
    "@concile/values": "workspace:*",
    "esbuild": "^0.27.0",
    "ws": "^8.18.0",
    "@concile/dashboard": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@levischuck/tiny-cbor": "0.2.11",
    "@simplewebauthn/server": "13.3.2",
    "@concile/auth": "workspace:*",
    "@concile/client": "workspace:*",
    "@concile/fleet": "workspace:*",
    "@concile/notifications": "workspace:*",
    "@concile/objectstore-substrate": "workspace:*",
    "@concile/scheduler": "workspace:*",
    "@concile/triggers": "workspace:*",
    "@concile/workflow": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "fake-indexeddb": "^6.0.0",
    "jose": "6.2.3",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@concile/tui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concile-dev/concile.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/concile-dev/concile"
}
