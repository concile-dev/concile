{
  "name": "@concile/runtime-cloudflare",
  "version": "0.1.5",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "vitest run --config vitest.workers.config.ts test-workers/*-e2e.test.ts --testTimeout=60000 --hookTimeout=60000",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@concile/admin": "workspace:*",
    "@concile/blobstore": "workspace:*",
    "@concile/cli": "workspace:*",
    "@concile/component": "workspace:*",
    "@concile/docstore": "workspace:*",
    "@concile/docstore-d1": "workspace:*",
    "@concile/docstore-do-sqlite": "workspace:*",
    "@concile/docstore-sqlite": "workspace:*",
    "@concile/executor": "workspace:*",
    "@concile/runtime-embedded": "workspace:*",
    "@concile/storage": "workspace:*",
    "@concile/sync": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.5.40",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@concile/blobstore-r2": "workspace:*",
    "@concile/docstore": "workspace:*",
    "@concile/id-codec": "workspace:*",
    "@concile/index-key-codec": "workspace:*",
    "@concile/values": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concile-dev/concile.git",
    "directory": "packages/runtime-cloudflare"
  },
  "homepage": "https://github.com/concile-dev/concile"
}
